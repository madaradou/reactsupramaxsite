# Client-side environment (public) - safe to keep site key here
# Do NOT put secrets prefixed with VITE_ if you want them to remain private.
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Server-side secrets (DO NOT commit actual .env file to the repo)
# Create a local file called .env (or server/.env) with these values.
OPENROUTER_API_KEY=your_openrouter_api_key_here
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here

# Server port for the proxy
SERVER_PORT=4000
WEB3FORMS_KEY=your_web3forms_key_here
